# General Configuration
PROJECT_NAME="Verified Lead Intelligence Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=development_secret_key_change_in_production_32bytes_min

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lead_intelligence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/lead_intelligence

# Redis & Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Service
NEXT_PUBLIC_API_URL=http://localhost:8000
